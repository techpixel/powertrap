# =============================================================================
#  Copy to .env  ->  cp .env.example .env  ->  then edit.
# =============================================================================

# --- core --------------------------------------------------------------------
PORT=8080
# Shared secret the ESP sends as "Authorization: Bearer <token>".
# Must match SHARED_TOKEN in firmware/powertrap/secrets.h.
# Generate one:  openssl rand -hex 24
SHARED_TOKEN=change-me-to-a-long-random-string
DEVICE_ID=sibo-1

# --- timing (tune the responsiveness vs false-alarm tradeoff) ----------------
# ESP sends a heartbeat every 20s (HEARTBEAT_INTERVAL_MS in firmware).
# Alert after this many seconds of silence (≈ 3 missed beats = survives a blip).
TIMEOUT_SECONDS=70
# How often the watchdog checks.
CHECK_INTERVAL_SECONDS=5
# While it stays down, re-alert this often, up to MAX_RENOTIFY times.
RENOTIFY_SECONDS=300
MAX_RENOTIFY=6

# Public URL of this server (optional) — makes notifications tappable -> /status
# PUBLIC_URL=https://powertrap.example.com

# =============================================================================
#  ALERT CHANNELS — fill in the ones you want. Each turns on when configured.
# =============================================================================

# --- ntfy push (recommended, free) -------------------------------------------
# Install the "ntfy" app, pick a hard-to-guess topic, and subscribe to it.
# Default uses the public server ntfy.sh; or self-host and set NTFY_URL.
NTFY_TOPIC=sibo-CHANGE-ME-to-something-random
# NTFY_URL=https://ntfy.sh
# 'high' = prominent heads-up push (recommended). 'max'/'urgent' = alarm/DND-bypass.
NTFY_PRIORITY=high
# NTFY_TOKEN=            # only if your ntfy topic requires auth

# --- email (optional) --------------------------------------------------------
# Works with any SMTP provider. For Gmail, use an App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false      # true for port 465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=you@gmail.com
# MAIL_TO=you@gmail.com

# --- Twilio phone call / SMS (optional, off by default) ----------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_FROM=+1XXXXXXXXXX   # your Twilio number
# TWILIO_TO=+1XXXXXXXXXX     # your phone
# TWILIO_ENABLE_SMS=false    # set true to also text you
